# Cloudflare Pages builds with `npx @cloudflare/next-on-pages@1`, which (via npm)
# pulls the latest wrangler (peer: @cloudflare/workers-types@^5) alongside
# next-on-pages (peer: @cloudflare/workers-types@^4). Strict peer resolution
# fails that conflict with ERESOLVE. Fall back to legacy peer resolution so the
# deploy build resolves. pnpm ignores this key and uses the committed lockfile.
legacy-peer-deps=true
